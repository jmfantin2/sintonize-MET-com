    <script>
      // Esperar o YouTube Iframe API carregar
      var tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      var firstScriptTag = document.getElementsByTagName('script')[0];
      firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

      let player;

      function onYouTubeIframeAPIReady() {
        player = new YT.Player('youtube-vsl', {
          events: {
            onReady: onPlayerReady,
          },
        });
      }

      function onPlayerReady(event) {
        const unmuteButton = document.getElementById('vsl-unmute');
        unmuteButton.addEventListener('click', () => {
          player.unMute();
          unmuteButton.style.display = 'none';
        });

        // Sincronizar barra de progresso
        const progress = document.getElementById('vsl-progress');
        setInterval(() => {
          const duration = player.getDuration();
          const currentTime = player.getCurrentTime();
          const percent = (currentTime / duration) * 100;
          progress.style.width = percent + '%';
        }, 500);
      }
    </script>
